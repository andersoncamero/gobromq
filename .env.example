# Variables de entorno para GoBroMQ
# Copia este archivo como .env y ajusta los valores según tu configuración

# Puerto del broker MQTT
GOBROMQ_PORT=1884

# Host del broker (vacío = todas las interfaces)
GOBROMQ_HOST=

# Configuración de Docker Compose
COMPOSE_PROJECT_NAME=gobromq

# Configuración de autenticación (opcional)
# GOBROMQ_AUTH_ENABLED=true
# GOBROMQ_ADMIN_USER=admin
# GOBROMQ_ADMIN_PASS=password123

# Configuración de logging (opcional)
# GOBROMQ_LOG_LEVEL=info
# GOBROMQ_LOG_FILE=gobromq.log

# Configuración de SSL/TLS (opcional, para futuras implementaciones)
# GOBROMQ_TLS_ENABLED=false
# GOBROMQ_TLS_CERT_FILE=
# GOBROMQ_TLS_KEY_FILE=
